[Unit]
Description=cjudge execution worker
After=network-online.target docker.service
Requires=docker.service

[Service]
User=cjudge-worker
Group=cjudge-worker
SupplementaryGroups=docker
Environment=DATABASE_URL_FILE=/etc/cjudge/worker-database-url
Environment=CJUDGE_RUNTIME=runsc
Environment=CJUDGE_WORKSPACE=/var/lib/cjudge/work
Environment=CJUDGE_WORKERS=2
StateDirectory=cjudge
ExecStart=/usr/local/bin/cjudge worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The host Docker daemon must see workspaces at the same absolute path.
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=256
# Sibling sandbox containers have their own limits, outside this unit's cgroup.

[Install]
WantedBy=multi-user.target
